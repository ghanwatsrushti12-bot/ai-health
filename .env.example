# Copy this file to `.env` and fill in real values.
# Never commit the real `.env` file — it is already in .gitignore.

# --- Core ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=carepulse.settings.development
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Kolkata

# --- Database -------------------------------------------------------------
# Defaults to SQLite if omitted. For production, e.g.:
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_URL=sqlite:///db.sqlite3

# --- Security (production only) --------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# --- Email ------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CarePulse <no-reply@carepulse.local>
EMAIL_HOST=smtp.yourprovider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
